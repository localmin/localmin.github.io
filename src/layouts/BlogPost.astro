---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Body from '../components/Body.astro'
import Content from '../components/Content.astro'

// Written by tools/import.mjs. No post carries a `description`, and notes
// exported after the Inkdrop migration store `createdAt` as an epoch number.
export interface Props {
  frontmatter: {
    title: string
    description?: string
    createdAt: string | number
    updatedAt?: string
    heroImage?: string
    tags: string[]
  }
}

const {
  frontmatter: { title, description, heroImage, createdAt }
} = Astro.props
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <Body>
    <Header />
    <main class="pt-[64px]">
      <Content className="markdown-content">
        <div class="mb-8">
          {
            heroImage && (
              <img
                class="border border-slate-300 dark:border-zinc-700 rounded-xl"
                width={720}
                height={360}
                src={heroImage}
                alt=""
              />
            )
          }
        </div>
        <div class="opacity-50 text-sm flex items-center gap-3">
          <span
            class="inline-block h-4 w-0.5 rounded-full bg-zinc-400 dark:bg-zinc-500"
          ></span>
          {
            new Intl.DateTimeFormat('en-US', {
              dateStyle: 'long'
            }).format(new Date(createdAt))
          }
        </div>
        <h1 class="text-3xl my-1 font-mplus">{title}</h1>
        <hr class="border-top border-zinc-400 my-4" />
        <slot />
      </Content>
    </main>
    <Footer />
  </Body>
</html>
